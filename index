    // APPLICATION STATE
    let currentQuestions = JSON.parse(JSON.stringify(RAW_QUESTIONS));
    let userAnswers = {};   // { qId: "A" }
    let checkedState = {};  // { qId: true/false }
    let filters = {
      package: 'all', // 'all', 'kisi', 'pengayaan'
      chapter: 'all'  // 'all', 'Dasar Geografi', 'Peta & Pemetaan', 'Penginderaan Jauh', 'SIG'
    };

    // INITIALIZATION
    window.onload = function() {
      renderNavigationGrid();
      renderQuestions();
      updateDashboardStats();
    };

    // RENDER NAVIGATION GRID (1 to 45)
    function renderNavigationGrid() {
      const navGrid = document.getElementById('nav-grid');
      navGrid.innerHTML = '';

      let count = 0;
      RAW_QUESTIONS.forEach(q => {
        // Apply current filter visibility to grid if needed, or show all 45
        const isVisible = checkFilterMatch(q);
        if (isVisible) count++;

        const navBtn = document.createElement('button');
        navBtn.className = 'nav-btn';
        navBtn.id = `nav-btn-${q.id}`;
        navBtn.innerText = q.id;

        if (!isVisible) {
          navBtn.style.opacity = '0.3';
        }

        // Apply state classes
        if (checkedState[q.id]) {
          if (userAnswers[q.id] === q.answer) {
            navBtn.classList.add('correct');
          } else {
            navBtn.classList.add('incorrect');
          }
        } else if (userAnswers[q.id]) {
          navBtn.classList.add('answered');
        }

        navBtn.onclick = () => scrollToQuestion(q.id);
        navGrid.appendChild(navBtn);
      });

      document.getElementById('grid-count').innerText = `${count} Soal`;
    }

    // CHECK IF QUESTION MATCHES CURRENT ACTIVE FILTERS
    function checkFilterMatch(q) {
      if (filters.package === 'kisi' && q.id > 30) return false;
      if (filters.package === 'pengayaan' && q.id <= 30) return false;
      if (filters.chapter !== 'all' && q.chapter !== filters.chapter) return false;
      return true;
    }

    // RENDER QUESTION CARDS
    function renderQuestions() {
      const container = document.getElementById('questions-container');
      container.innerHTML = '';

      let visibleCount = 0;

      currentQuestions.forEach(q => {
        if (!checkFilterMatch(q)) return;
        visibleCount++;

        const isChecked = checkedState[q.id] || false;
        const selectedOpt = userAnswers[q.id] || null;

        const card = document.createElement('div');
        card.className = 'question-card';
        card.id = `q-card-${q.id}`;

        // Header Status Text
        let statusHtml = '<span class="card-status unanswered">Belum Dijawab</span>';
        if (isChecked) {
          if (selectedOpt === q.answer) {
            statusHtml = '<span class="card-status correct">✓ Jawaban Benar</span>';
          } else {
            statusHtml = '<span class="card-status incorrect">✕ Jawaban Salah</span>';
          }
        } else if (selectedOpt) {
          statusHtml = '<span class="card-status answered">Disimpan (Belum Dicek)</span>';
        }

        // Badge Tag Class
        const isKisi = q.id <= 30;
        const tagClass = isKisi ? 'badge-kisi' : 'badge-pengayaan';

        // Build Options HTML
        let optionsHtml = '';
        const optionKeys = ['A', 'B', 'C', 'D', 'E'];

        optionKeys.forEach(key => {
          if (!q.options[key]) return;
          const optText = q.options[key];
          const isSelected = selectedOpt === key;

          let optionStateClass = '';
          if (isChecked) {
            if (key === q.answer) {
              optionStateClass = 'state-correct';
            } else if (isSelected && key !== q.answer) {
              optionStateClass = 'state-wrong';
            }
          }

          optionsHtml += `
            <label class="option-item ${optionStateClass}" onclick="selectAnswer(${q.id}, '${key}')">
              <input type="radio" name="question_${q.id}" value="${key}" ${isSelected ? 'checked' : ''} ${isChecked ? 'disabled' : ''}>
              <span class="option-key">${key}.</span>
              <span class="option-text">${escapeHtml(optText)}</span>
            </label>
          `;
        });

        // Card Template
        card.innerHTML = `
          <div class="card-header">
            <div class="badges">
              <span class="badge badge-number">Soal #${q.id}</span>
              <span class="badge badge-chapter">${q.chapter}</span>
              <span class="badge ${tagClass}">${q.tag}</span>
            </div>
            <div>${statusHtml}</div>
          </div>

          <div class="question-text">${escapeHtml(q.question)}</div>

          <div class="options-list">
            ${optionsHtml}
          </div>

          <div class="card-actions">
            <button class="btn btn-primary" onclick="checkSingleAnswer(${q.id})">Cek Jawaban</button>
            <button class="btn btn-secondary" onclick="resetSingleAnswer(${q.id})">Ulangi Soal Ini</button>
          </div>

          <div class="explanation-box" id="exp-${q.id}" style="display: ${isChecked ? 'block' : 'none'};">
            <div class="explanation-title">💡 Kunci Jawaban & Pembahasan (${q.answer})</div>
            <div class="explanation-body">${escapeHtml(q.explanation)}</div>
          </div>
        `;

        container.appendChild(card);
      });

      if (visibleCount === 0) {
        container.innerHTML = `
          <div class="empty-state panel">
            <h3>Tidak ada soal yang cocok dengan filter.</h3>
            <p style="margin-top: 8px;">Coba ubah kombinasi filter bab atau kategori soal.</p>
          </div>
        `;
      }
    }

    // USER ACTIONS
    function selectAnswer(qId, key) {
      if (checkedState[qId]) return; // locked if checked
      userAnswers[qId] = key;

      // Update nav grid state
      const navBtn = document.getElementById(`nav-btn-${qId}`);
      if (navBtn) navBtn.classList.add('answered');

      // Update status text on card
      const card = document.getElementById(`q-card-${qId}`);
      if (card) {
        const statusElem = card.querySelector('.card-header div:last-child');
        if (statusElem) statusElem.innerHTML = '<span class="card-status answered">Disimpan (Belum Dicek)</span>';
      }

      updateDashboardStats();
    }

    function checkSingleAnswer(qId) {
      if (!userAnswers[qId]) {
        showToast("Pilih salah satu jawaban terlebih dahulu!");
        return;
      }

      checkedState[qId] = true;
      renderQuestions();
      renderNavigationGrid();
      updateDashboardStats();

      // Scroll to explanation box smoothly
      const expBox = document.getElementById(`exp-${qId}`);
      if (expBox) {
        expBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function resetSingleAnswer(qId) {
      delete userAnswers[qId];
      delete checkedState[qId];
      renderQuestions();
      renderNavigationGrid();
      updateDashboardStats();
      showToast(`Soal #${qId} telah direset.`);
    }

    function checkAllAnswers() {
      const totalAnswered = Object.keys(userAnswers).length;
      if (totalAnswered === 0) {
        showToast("Belum ada soal yang dijawab!");
        return;
      }

      // Mark all answered questions as checked
      RAW_QUESTIONS.forEach(q => {
        if (userAnswers[q.id]) {
          checkedState[q.id] = true;
        }
      });

      renderQuestions();
      renderNavigationGrid();
      updateDashboardStats();
      openModalAnalysis();
    }

    function confirmResetAll() {
      if (Object.keys(userAnswers).length === 0 && Object.keys(checkedState).length === 0) {
        showToast("Semua lembar jawab sudah bersih.");
        return;
      }
      
      userAnswers = {};
      checkedState = {};
      renderQuestions();
      renderNavigationGrid();
      updateDashboardStats();
      showToast("Seluruh jawaban berhasil direset ke nol!");
    }

    function shuffleQuestionsAndOptions() {
      // Shuffle question cards array order
      currentQuestions = shuffleArray([...currentQuestions]);

      // Shuffle options inside each question
      currentQuestions.forEach(q => {
        const keys = ['A', 'B', 'C', 'D', 'E'].filter(k => q.options[k]);
        const shuffledKeys = shuffleArray([...keys]);
        
        // Re-map options and find new correct answer key
        const newOptions = {};
        let newAnswerKey = q.answer;

        const originalCorrectText = q.options[q.answer];

        keys.forEach((origKey, index) => {
          const targetKey = shuffledKeys[index];
          newOptions[targetKey] = q.options[origKey];
        });

        // Find which new key holds originalCorrectText
        Object.keys(newOptions).forEach(k => {
          if (newOptions[k] === originalCorrectText) {
            newAnswerKey = k;
          }
        });

        q.options = newOptions;
        q.answer = newAnswerKey;
      });

      renderQuestions();
      showToast("Soal & opsi pilihan telah diacak!");
    }

    // UTILITY SHUFFLE
    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    // UPDATE DASHBOARD REAL-TIME STATS
    function updateDashboardStats() {
      const totalAnswered = Object.keys(userAnswers).length;
      
      let correctCount = 0;
      let wrongCount = 0;

      RAW_QUESTIONS.forEach(q => {
        if (checkedState[q.id]) {
          if (userAnswers[q.id] === q.answer) {
            correctCount++;
          } else {
            wrongCount++;
          }
        }
      });

      // Calculate score scaled 0-100 based on total 45 questions
      const score = ((correctCount / RAW_QUESTIONS.length) * 100).toFixed(1);

      document.getElementById('stat-answered').innerText = `${totalAnswered} / ${RAW_QUESTIONS.length}`;
      document.getElementById('stat-correct').innerText = correctCount;
      document.getElementById('stat-wrong').innerText = wrongCount;
      document.getElementById('stat-score').innerText = score;
    }

    // FILTER LOGIC
    function setFilter(type, value, btnElem) {
      filters[type] = value;

      // Update active button state in group
      const parent = btnElem.parentElement;
      const btns = parent.querySelectorAll('.btn-filter');
      btns.forEach(b => b.classList.remove('active'));
      btnElem.classList.add('active');

      renderQuestions();
      renderNavigationGrid();
    }

    // SCROLL TO QUESTION CARD
    function scrollToQuestion(qId) {
      // Ensure filter doesn't hide it
      const q = RAW_QUESTIONS.find(item => item.id === qId);
      if (q && !checkFilterMatch(q)) {
        // Reset filters if navigating to hidden question
        filters.package = 'all';
        filters.chapter = 'all';
        document.querySelectorAll('.btn-filter').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.filter-buttons').forEach(fb => fb.children[0].classList.add('active'));
        renderQuestions();
        renderNavigationGrid();
      }

      const card = document.getElementById(`q-card-${qId}`);
      if (card) {
        card.scrollIntoView({ behavior: 'smooth' });
        
        // Highlight active nav
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active-current'));
        const navBtn = document.getElementById(`nav-btn-${qId}`);
        if (navBtn) navBtn.classList.add('active-current');
      }
    }

    // MODAL ANALYSIS
    function openModalAnalysis() {
      const modal = document.getElementById('result-modal');
      
      let correctCount = 0;
      let wrongCount = 0;

      // Chapter breakdown object
      const chapterStats = {
        "Dasar Geografi": { total: 0, correct: 0 },
        "Peta & Pemetaan": { total: 0, correct: 0 },
        "Penginderaan Jauh": { total: 0, correct: 0 },
        "SIG": { total: 0, correct: 0 }
      };

      RAW_QUESTIONS.forEach(q => {
        if (chapterStats[q.chapter]) chapterStats[q.chapter].total++;

        if (checkedState[q.id]) {
          if (userAnswers[q.id] === q.answer) {
            correctCount++;
            if (chapterStats[q.chapter]) chapterStats[q.chapter].correct++;
          } else {
            wrongCount++;
          }
        }
      });

      const unansweredCount = RAW_QUESTIONS.length - (correctCount + wrongCount);
      const scoreNum = Math.round((correctCount / RAW_QUESTIONS.length) * 100);

      document.getElementById('modal-score-num').innerText = scoreNum;
      document.getElementById('modal-correct').innerText = correctCount;
      document.getElementById('modal-wrong').innerText = wrongCount;
      document.getElementById('modal-unanswered').innerText = unansweredCount;

      // Render Chapter Progress Bars
      const listContainer = document.getElementById('chapter-analysis-list');
      listContainer.innerHTML = '';

      Object.keys(chapterStats).forEach(chName => {
        const stat = chapterStats[chName];
        const pct = stat.total > 0 ? Math.round((stat.correct / stat.total) * 100) : 0;

        const item = document.createElement('div');
        item.className = 'chapter-bar-item';
        item.innerHTML = `
          <div class="chapter-bar-label">
            <span>${chName}</span>
            <span style="font-weight: 700;">${stat.correct} / ${stat.total} (${pct}%)</span>
          </div>
          <div class="progress-bg">
            <div class="progress-fill" style="width: ${pct}%;"></div>
          </div>
        `;
        listContainer.appendChild(item);
      });

      modal.style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('result-modal').style.display = 'none';
    }

    // TOAST NOTIFICATION UTILITY
    function showToast(msg) {
      const toast = document.getElementById('toast-msg');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    // HELPER: ESCAPE HTML TO PREVENT FORMAT BREAKAGE
    function escapeHtml(text) {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
